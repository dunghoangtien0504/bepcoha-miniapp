# Mini App HACO — biến môi trường (chép thành .env.local). Không có bí mật nào ở đây: mọi khoá nằm ở Haco-OS.

# Dev: Haco-OS-v2 chạy ở đâu (Vite proxy /api sang đây)
HACO_API_ORIGIN=http://localhost:3030

# ID Zalo OA của HACO (trống = chưa có OA → ẩn nút quan tâm OA)
VITE_ZALO_OA_ID=

# Link chat (nút Chat luôn nổi — B4 K14: 60–70% khách vẫn chat để mua)
VITE_MESSENGER_URL=https://m.me/
VITE_ZALO_CHAT_URL=

# Nhóm Zalo "Group bếp" của Cô Hạ (https://zalo.me/g/…). Trống thì ô Group bếp mở nhóm Facebook.
VITE_ZALO_GROUP_URL=

# Đợt A chưa đặt hàng trong Mini App: nút "Mua combo" dẫn sang trang này
VITE_COMBO_URL=

# Link công khai của Mini App để khách chia sẻ cho bạn (vd https://hacofood.vn/m)
VITE_PUBLIC_URL=
